{
  "name": "@skew/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "lint": "nx run-many -t lint",
    "lint:libs": "nx run-many -t lint -p core build-tools angular-router angular-data angular-workflow",
    "lint:fix": "nx run-many -t lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "nx run-many -t test",
    "test:libs": "nx run-many -t test -p core build-tools angular-router angular-data angular-workflow",
    "test:core": "nx test core",
    "test:angular-core": "nx test angular-core",
    "test:build-tools": "nx test build-tools",
    "test:angular-router": "nx test angular-router",
    "test:angular-data": "nx test angular-data",
    "test:angular-workflow": "nx test angular-workflow",
    "build": "nx run-many -t build",
    "build:libs": "nx run-many -t build -p core build-tools angular-router angular-data angular-workflow",
    "build:core": "nx build core",
    "build:angular-core": "nx build angular-core",
    "build:build-tools": "nx build build-tools",
    "build:angular-router": "nx build angular-router",
    "build:angular-data": "nx build angular-data",
    "build:angular-workflow": "nx build angular-workflow",
    "verify": "npm run lint:libs && npm run test:libs && npm run build:libs",
    "release:version": "nx release version",
    "release:changelog": "nx release changelog",
    "deploy:libs:dry-run": "nx release publish --dry-run",
    "deploy:libs": "nx release publish",
    "registry": "nx local-registry",
    "deploy:libs:local": "nx release publish --registry=http://localhost:4873",
    "start": "nx serve shell",
    "demo": "nx serve shell",
    "demo:build": "nx build shell",
    "demo:serve-static": "nx serve-static shell",
    "demo:prod": "npm run demo:prod:build && npm run demo:prod:serve",
    "demo:prod:build": "npm run demo:prod:deploy-remote && npm run demo:prod:deploy-host",
    "demo:prod:deploy-host": "node tools/deploy-demo.mjs host",
    "demo:prod:deploy-remote": "node tools/deploy-demo.mjs remote",
    "demo:prod:redeploy-remote": "node tools/deploy-demo.mjs remote",
    "demo:prod:serve": "nx run-many -t serve-dist -p prod-host prod-remote --parallel=2",
    "demo:prod:serve-host": "nx serve-dist prod-host",
    "demo:prod:serve-remote": "nx serve-dist prod-remote",
    "demo:prod:dev": "nx run-many -t serve -p prod-host prod-remote --parallel=2"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "~22.0.4",
    "@angular-devkit/schematics": "~22.0.4",
    "@angular/build": "~22.0.4",
    "@angular/cli": "~22.0.4",
    "@angular/compiler-cli": "~22.0.4",
    "@angular/language-service": "~22.0.4",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "^23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/vite": "^23.1.1",
    "@nx/web": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@schematics/angular": "~22.0.4",
    "@softarc/native-federation-orchestrator": "^4.2.2",
    "@swc/helpers": "~0.5.18",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "^22.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "ng-packagr": "~22.0.0",
    "nx": "23.1.1",
    "postcss": "^8.4.5",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "verdaccio": "^6.3.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@angular-architects/native-federation": "^22.0.6",
    "@angular/common": "~22.0.4",
    "@angular/compiler": "~22.0.4",
    "@angular/core": "~22.0.4",
    "@angular/forms": "~22.0.4",
    "@angular/platform-browser": "~22.0.4",
    "@angular/router": "~22.0.4",
    "es-module-shims": "^2.8.0",
    "rxjs": "~7.8.0"
  },
  "nx": {
    "includedScripts": []
  }
}
