{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@braid/angular-data": ["./libs/angular/data/src/index.ts"],
      "@braid/angular-router": ["./libs/angular/router/src/index.ts"],
      "@braid/angular-workflow": ["./libs/angular/workflow/src/index.ts"],
      "@braid/core": ["./libs/core/src/index.ts"],
      "@braid/angular": ["./libs/braid-angular/src/index.ts"],
      "@braid/cli": ["./libs/braid-cli/src/index.ts"],
      "@braid/console": ["./libs/braid-console/src/index.ts"],
      "@braid/react": ["./libs/braid-react/src/index.ts"],
      "@braid/registry": ["./libs/braid-registry/src/index.ts"],
      "@braid/registry/node": ["./libs/braid-registry/src/node.ts"],
      "@braid/sw": ["./libs/braid-sw/src/index.ts"],
      "@braid/gateway": ["./libs/braid-gateway/src/index.ts"],
      "@braid/gateway/node": ["./libs/braid-gateway/src/node.ts"],
      "@braid/build": ["./libs/build/src/index.ts"],
      "@braid/contract": ["./libs/contract/src/index.ts"],
      "@braid/skew": ["./libs/skew/src/index.ts"],
      "@braid/data": ["./libs/data/src/index.ts"],
      "@braid/studio": ["./libs/studio/src/index.ts"],
      "@braid/angular-core": ["./libs/angular/core/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
