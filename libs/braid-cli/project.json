{
  "name": "braid-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/braid-cli/src",
  "projectType": "library",
  "tags": ["scope:shared", "framework:agnostic"],
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "outputPath": "dist/libs/braid-cli",
        "main": "libs/braid-cli/src/index.ts",
        "additionalEntryPoints": ["libs/braid-cli/src/bin.ts", "libs/braid-cli/src/nx/plugin.ts"],
        "tsConfig": "libs/braid-cli/tsconfig.build.json",
        "assets": ["libs/braid-cli/*.md"]
      }
    },
    "nx-release-publish": {
      "options": {
        "packageRoot": "dist/{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "vitest run --config libs/braid-cli/vite.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
