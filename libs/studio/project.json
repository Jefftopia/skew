{
  "name": "studio",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/studio/src",
  "projectType": "library",
  "tags": ["scope:shared", "framework:agnostic"],
  "release": {
    "version": {
      "manifestRootsToUpdate": ["dist/{projectRoot}"],
      "currentVersionResolver": "git-tag",
      "fallbackCurrentVersionResolver": "disk"
    }
  },
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "outputPath": "dist/libs/studio",
        "main": "libs/studio/src/index.ts",
        "tsConfig": "libs/studio/tsconfig.lib.json",
        "assets": ["libs/studio/*.md"]
      }
    },
    "nx-release-publish": { "options": { "packageRoot": "dist/{projectRoot}" } },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": { "command": "vitest run --config libs/studio/vite.config.ts" }
    },
    "lint": { "executor": "@nx/eslint:lint" }
  }
}
